{
  "manifest_version": 3,
  "name": "Opposite Pin Library",
  "version": "0.1.0",
  "description": "Save, organize and re-apply Warcraft Logs pins.",
  "minimum_chrome_version": "141",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Opposite Pin Library",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://*.warcraftlogs.com/*"],
  "content_scripts": [
    {
      "matches": ["https://*.warcraftlogs.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.warcraftlogs.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open or close the pin library"
    }
  }
}
